{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "deployment": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "managed-rfe-argocd",
            "byo-cluster-argocd",
            "byo-rfe-argocd",
            "reference-full-stack"
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "managed",
            "external"
          ]
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "gitops": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string"
                },
                "project": {
                  "type": "string"
                },
                "server": {
                  "type": "string"
                },
                "controllerServiceAccount": {
                  "type": "string"
                }
              }
            }
          }
        },
        "pipelines": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "registry": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "imagePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*/[A-Za-z0-9_./-]+$"
                },
                "publisherSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            }
          }
        }
      }
    },
    "publicationEndpoints": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "push": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
