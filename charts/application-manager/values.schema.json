{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "deployment": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "managed-rfe-argocd",
            "byo-cluster-argocd",
            "byo-rfe-argocd",
            "reference-full-stack"
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "managed",
            "external"
          ]
        }
      }
    },
    "components": {
      "type": "object",
      "properties": {
        "gitops": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string"
                },
                "project": {
                  "type": "string"
                },
                "server": {
                  "type": "string"
                },
                "controllerServiceAccount": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
