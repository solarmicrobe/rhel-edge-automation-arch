{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "components": {
      "type": "object",
      "properties": {
        "virtualization": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1
                },
                "dataSource": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "namespace": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "if": {
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "const": "byo"
              }
            }
          },
          "then": {
            "required": [
              "connection"
            ],
            "properties": {
              "connection": {
                "required": [
                  "namespace"
                ]
              }
            }
          }
        }
      }
    }
  }
}
