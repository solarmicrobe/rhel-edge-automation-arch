{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "components": {
      "type": "object",
      "properties": {
        "imageBuilderVM": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"
                },
                "sshSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "pipelines": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "registry": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "imagePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*/[A-Za-z0-9_./-]+$"
                },
                "publisherSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "nexus": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "credentialsSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "credentialsSecretNamespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "serviceName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "servicePort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "httpScheme": {
                  "type": "string",
                  "enum": [
                    "http",
                    "https"
                  ]
                },
                "routeName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "routeNamespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "kickstartRepository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "autoIsoRepository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            },
            "artifacts": {
              "type": "object",
              "properties": {
                "upload": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "publicationEndpoints": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "properties": {
                "push": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
