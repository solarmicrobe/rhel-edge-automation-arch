{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "components": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "imagePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*/[A-Za-z0-9_./-]+$"
                },
                "publisherSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "pullSecretName": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
                  "maxLength": 253
                }
              }
            }
          }
        }
      }
    }
  }
}
