{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
    "components": {
      "type": "object",
      "properties": {
        "imageBuilderVM": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?$"
                },
                "sshSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "pipelines": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                }
              }
            }
          }
        },
        "registry": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "imagePath": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9.:-]*/[A-Za-z0-9_./-]+$"
                },
                "publisherSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "pullSecretName": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
                  "maxLength": 253
                }
              }
            }
          }
        },
        "nexus": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "credentialsSecretName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "credentialsSecretNamespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "serviceName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "servicePort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "httpScheme": {
                  "type": "string",
                  "enum": [
                    "http",
                    "https"
                  ]
                },
                "routeName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "routeNamespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "kickstartRepository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                },
                "autoIsoRepository": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
                }
              }
            },
            "artifacts": {
              "type": "object",
              "properties": {
                "upload": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "httpd": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed",
                "byo",
                "disabled"
              ]
            },
            "connection": {
              "type": "object",
              "properties": {
                "routeName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
                },
                "stageServiceAccountName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 253,
                  "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
                },
                "routeNamespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                },
                "podNamespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
                },
                "podLabelSelector": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*=[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "webRoot": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^(/[A-Za-z0-9_-]+)+$"
                }
              }
            }
          }
        }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "composeImage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "stageImage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "publishOstree": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "publishIso": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "serveKickstarts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        }
      },
      "required": [
        "composeImage",
        "stageImage",
        "publishOstree",
        "publishIso",
        "serveKickstarts"
      ]
    },
    "permissions": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "managed",
            "external"
          ]
        }
      }
    },
    "publicationEndpoints": {
      "type": "object",
      "properties": {
        "httpServing": {
          "type": "object",
          "properties": {
            "routeName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
            },
            "stageServiceAccountName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
            },
            "routeNamespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "podNamespace": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
            },
            "podLabelSelector": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*=[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "webRoot": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(/[A-Za-z0-9_-]+)+$"
            },
            "content": {
              "type": "object",
              "properties": {
                "write": {
                  "type": "boolean"
                }
              }
            },
            "staging": {
              "type": "object",
              "properties": {
                "create": {
                  "type": "boolean"
                }
              }
            },
            "mode": {
              "type": "string",
              "enum": [
                "managed-reference"
              ]
            }
          }
        },
        "registry": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed-reference",
                "external"
              ]
            }
          }
        },
        "artifactRepository": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "managed-reference",
                "disabled"
              ]
            }
          }
        }
      }
    },
    "deployment": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "managed-rfe-argocd",
            "byo-cluster-argocd",
            "byo-rfe-argocd",
            "reference-full-stack"
          ]
        }
      }
    }
  },
  "required": [
    "workflows"
  ]
}
